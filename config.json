{
  "ping_interval_seconds": 30,
  "ping_count": 5,
  "ping_timeout_seconds": 10,
  "verification_site_count": 3,
  
  "restart_cooldown_minutes": 15,
  "restart_wait_seconds": 90,
  "restart_max_retries": 3,
  "restart_retry_delay_minutes": 10,
  "post_restart_ping_count": 5,
  
  "cluster_enabled": false,
  "node_id": "node-1",
  "cluster_nodes": [],
  "cluster_api_port": 8080,
  "cluster_api_listen": "0.0.0.0:8080",
  "cluster_lock_timeout_seconds": 300,
  "cluster_health_check_seconds": 10,
  
  "state_file_path": "/var/log/restartko/state.json",
  "state_save_interval_seconds": 30,
  
  "power_loss_grace_period_minutes": 5,
  "power_loss_restart_delay_minutes": 2,
  
  "dns_cache_ttl_minutes": 5,
  "use_raw_sockets": true,
  
  "log_level": "info",
  
  "sites": [
    {
      "name": "Google DNS",
      "address": "8.8.8.8",
      "priority": 100,
      "verification_only": false
    },
    {
      "name": "Cloudflare DNS",
      "address": "1.1.1.1",
      "priority": 90,
      "verification_only": false
    },
    {
      "name": "Google",
      "address": "google.com",
      "priority": 80,
      "verification_only": false
    },
    {
      "name": "Cloudflare",
      "address": "cloudflare.com",
      "priority": 70,
      "verification_only": true
    },
    {
      "name": "OpenDNS",
      "address": "208.67.222.222",
      "priority": 60,
      "verification_only": true
    }
  ],
  
  "router": {
    "type": "generic_http",
    "address": "192.168.1.1",
    "username": "admin",
    "password": "your-router-password",
    
    "login_url": "http://192.168.1.1/login.cgi",
    "restart_url": "http://192.168.1.1/reboot.cgi",
    "login_method": "POST",
    "login_form_fields": {
      "username": "{username}",
      "password": "{password}"
    },
    "restart_method": "POST",
    "restart_form_fields": {
      "action": "reboot"
    },
    "session_cookie_name": "SessionID",
    "verify_ssl": false,
    
    "csrf_enabled": false,
    "csrf_token_url": "",
    "csrf_token_field": "csrftoken",
    "csrf_token_pattern": "",
    "csrf_token_input_name": "csrftoken",
    
    "uptime_check_enabled": false,
    "uptime_check_url": "",
    "uptime_pattern": "",
    
    "port": 22,
    "restart_command": "reboot",
    
    "timeout_seconds": 30,
    "custom_headers": {
      "User-Agent": "RestartKO/1.0"
    }
  }
}

